+fn seed_funding_scan_range(db: &Database) {
+    pirate_storage_sqlite::scan_queue::ScanQueueStorage::new(db)
+        .record_historic_scanned_range(1, 1_201, Some("qortal-funding-regression"))
+        .unwrap();
+}
